# Copy to .env to change a value. Every setting is optional; the value shown is the built-in default.
# Numbering link inferred from the data, not a stated rule: regex for a light_id, one group around the digits
LIGHT_PATTERN=SL(\d{5})
# Regex for a pole_id, one group around the digits
POLE_PATTERN=P(\d{4})
# Light number that goes with the first pole number
LIGHT_BASE=10000
# First pole number
POLE_BASE=4000
# Light numbers added per POLE_STEP poles
LIGHT_STEP=7
# Pole numbers per LIGHT_STEP lights
POLE_STEP=3
# A light further than this many metres from its nearest road is flagged
FAR_FROM_ROAD_M=15
# Two lights on a road closer than this many metres are both flagged
TOO_CLOSE_M=5
# Metric CRS used for distances (GDA2020 MGA Zone 55)
PROJECTED_CRS=EPSG:7855
# The lights GeoJSON, relative to the repo (or an absolute path)
LIGHTS_PATH=data/lights.geojson
# The roads GeoJSON, relative to the repo (or an absolute path)
ROADS_PATH=data/roads.geojson
# The result CSV, relative to the repo
OUTPUT_CSV=output/light_road_assignment.csv
# Console detail: DEBUG, INFO, WARNING, ERROR or CRITICAL
LOG_LEVEL=INFO
